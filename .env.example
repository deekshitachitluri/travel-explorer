# Travel Explorer Configuration Template
# Copy this file to .env if utilizing custom cloud endpoints

# Open-Meteo Weather API (Free open-source endpoint, no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Google Maps API (Optional for embedded maps, external Google Maps deep links are used by default without keys)
# GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Firebase Authentication (Follow instructions in README.md or Profile > Firebase Setup Guide)
# Place google-services.json inside android/app/
